#!/bin/bash
# Opens Keel in its own window using a Chromium-based browser (needed for saving into this folder).
APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
ROOT="$(dirname "$APP_DIR")"
HTML="$ROOT/Keel.html"
URL="file://$(printf '%s' "$HTML" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/#/%23/g')"
for B in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium" "Vivaldi"; do
  if [ -d "/Applications/$B.app" ] || [ -d "$HOME/Applications/$B.app" ]; then
    exec open -na "$B" --args --app="$URL" --window-size=1480,980
  fi
done
# No Chromium browser found: open in the default browser (viewing works; saving to the folder needs Chrome, Edge or Brave).
exec open "$HTML"
